<?xml version="1.0" encoding="utf-8"?>
<!--
  Default chat head. To customise it, add a layout with the same name
  (chat_head_layout.xml) to your app's res/layout folder and keep these view ids.
-->
<RelativeLayout
  xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:tools="http://schemas.android.com/tools"
  android:id="@+id/chat_head_root"
  android:layout_width="65dp"
  android:layout_height="wrap_content">

  <!-- Left without a src so the module falls back to the app icon. -->
  <ImageView
    android:id="@+id/chat_head_profile_iv"
    android:layout_width="60dp"
    android:layout_height="60dp"
    android:layout_marginTop="8dp"
    tools:ignore="ContentDescription" />

  <ImageView
    android:id="@+id/close_btn"
    android:layout_width="20dp"
    android:layout_height="20dp"
    android:layout_marginStart="40dp"
    android:src="@drawable/chat_head_close"
    tools:ignore="ContentDescription" />

  <TextView
    android:id="@+id/chat_head_badge"
    android:layout_width="26dp"
    android:layout_height="26dp"
    android:layout_alignParentStart="true"
    android:layout_margin="5dp" />
</RelativeLayout>
